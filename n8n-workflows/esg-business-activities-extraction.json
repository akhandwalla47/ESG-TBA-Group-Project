    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE companies\nSET\n    financial_year = COALESCE($1, financial_year),\n    extraction_status = 'completed',\n    last_extracted_at = NOW(),\n    extraction_error = NULL\nWHERE company_id = $2\nRETURNING\n    company_id,\n    company_name,\n    financial_year,\n    extraction_status,\n    last_extracted_at,\n    total_reported_revenue;",
        "options": {
          "queryReplacement": "={{\n  [\n    $('Parse & Validate Extraction').first().json.reporting_year,\n    $('Parse & Validate Extraction').first().json.company_id\n  ]\n}}"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        2912,
        80
      ],
      "id": "08e617df-4748-4c6f-837b-787e6fc191bb",
      "name": "Update Company",
      "executeOnce": true,
      "credentials": {
        "postgres": {
          "id": "UaVMen7JCP5Sk7OP",
          "name": "Postgres account 6"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst response = $input.first().json;\n\n// Extract the model's JSON response\nlet data = response;\n\nif (typeof response.text === 'string') {\n  data = JSON.parse(response.text);\n} else if (\n  response.output &&\n  typeof response.output === 'object' &&\n  !Array.isArray(response.output)\n) {\n  data = response.output;\n} else if (Array.isArray(response.output)) {\n  // Handle Responses API output format\n  const message = response.output.find(\n    item => item.type === 'message'\n  );\n\n  const rawText = message?.content?.find(\n    item => item.type === 'output_text'\n  )?.text;\n\n  if (!rawText) {\n    throw new Error('Gemini returned no extraction text.');\n  }\n\n  const cleaned = rawText\n    .replace(/```json/gi, '')\n    .replace(/```/g, '')\n    .trim();\n\n  try {\n    data = JSON.parse(cleaned);\n  } catch (error) {\n    throw new Error(\n      `Could not parse Gemini JSON: ${error.message}. Preview: ${cleaned.slice(0, 1000)}`\n    );\n  }\n}\n\n// Validate the business_segments array\nif (!Array.isArray(data.business_segments)) {\n  throw new Error(\n    'Missing or invalid business_segments array.'\n  );\n}\n\n// Retrieve original company and filing information\nconst request = $('When Executed by Another Workflow').first().json;\nconst filing = $('Retrieve File Location').first().json;\n\n// Validate and standardise each business segment\nconst segments = data.business_segments.map((segment, index) => {\n  if (\n    typeof segment.stream_name !== 'string' ||\n    !segment.stream_name.trim()\n  ) {\n    throw new Error(\n      `Business segment ${index + 1} has no valid stream_name.`\n    );\n  }\n\n  if (\n    segment.business_activities !== null &&\n    segment.business_activities !== undefined &&\n    typeof segment.business_activities !== 'string'\n  ) {\n    throw new Error(\n      `Business activities for ${segment.stream_name} must be a text string.`\n    );\n  }\n\n  return {\n    stream_name: segment.stream_name.trim(),\n\n    display_name:\n      typeof segment.display_name === 'string' &&\n      segment.display_name.trim()\n        ? segment.display_name.trim()\n        : segment.stream_name.trim(),\n\n    business_description:\n      segment.business_description ?? null,\n\n    business_activities:\n      segment.business_activities ?? null,\n\n    supporting_evidence:\n      segment.supporting_evidence ?? null,\n\n    source_page:\n  segment.source_page !== null &&\n  segment.source_page !== undefined\n    ? String(segment.source_page)\n    : null\n  };\n});\n\n// Return one structured extraction object\nreturn [{\n  json: {\n    company_id: request.company_id,\n    company_name: data.company_name || request.company_name,\n    company_crn: request.company_crn,\n    filing_id: filing.filing_id ?? request.filing_id ?? null,\n\n    reporting_year:\n      data.reporting_year || filing.financial_year,\n\n    extraction_method: 'business_segment_extraction',\n\n    business_segments: segments,\n\n    disclosure_gaps: Array.isArray(data.disclosure_gaps)\n      ? data.disclosure_gaps\n      : []\n  }\n}];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2288,
        80
      ],
      "id": "756b60be-712e-4e6c-993d-b0a61355dea6",
      "name": "Parse & Validate Extraction"
    },
    {
      "parameters": {
        "jsCode": "\nconst data = $input.first().json;\n\n// Read the business segments from Parse & Validate\nconst segments = data.business_segments || [];\n\nif (!segments.length) {\n  throw new Error(\n    'No business segments were identified. Check the Parse & Validate extraction output before inserting into PostgreSQL.'\n  );\n}\n\n// Create one database item per reported business segment\nreturn segments.map((segment, index) => {\n\n  if (\n    typeof segment.stream_name !== 'string' ||\n    !segment.stream_name.trim()\n  ) {\n    throw new Error(\n      `Business segment ${index + 1} is missing its name.`\n    );\n  }\n\n  return {\n    json: {\n      company_id: data.company_id,\n\n      company_name: data.company_name,\n\n      reporting_year: data.reporting_year,\n\n      stream_name: segment.stream_name.trim(),\n\n      display_name:\n        segment.display_name?.trim() ||\n        segment.stream_name.trim(),\n\n      business_description:\n        segment.business_description ?? null,\n\n      business_activities:\n        segment.business_activities ?? null,\n\n      supporting_evidence:\n        segment.supporting_evidence ?? null,\n\n      source_page:\n        segment.source_page ?? null\n    }\n  };\n});\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2512,
        80
      ],
      "id": "698bfe7d-bbb7-4d52-aec0-4c5be8e1196e",
