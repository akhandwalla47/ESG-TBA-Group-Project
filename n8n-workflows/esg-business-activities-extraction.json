    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO revenue_streams (\n    company_id,\n    stream_name,\n    reporting_year,\n    business_description,\n    supporting_evidence,\n    source_page,\n    display_name,\n    business_activities\n)\nVALUES (\n    $1, $2, $3, $4, $5, $6, $7, $8\n)\nRETURNING\n    revenue_id,\n    company_id,\n    stream_name,\n    display_name,\n    reporting_year,\n    business_description,\n    business_activities,\n    supporting_evidence,\n    source_page;",
        "options": {
          "queryReplacement": "=\n{{\n  [\n    $json.company_id,\n    $json.stream_name,\n    $json.reporting_year,\n    $json.business_description ?? null,\n    $json.supporting_evidence ?? null,\n    $json.source_page ?? null,\n    $json.display_name ?? null,\n    $json.business_activities ?? null\n  ]\n}}\n"
        }
      },
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.8,
      "position": [
        2704,
        80
      ],
      "id": "55d4d6dd-8ee7-4ac2-b4f9-da7f958beb63",
      "name": "Insert Revenue Stream",
