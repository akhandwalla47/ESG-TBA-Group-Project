    {
      "parameters": {
        "jsCode": "const items = $json.items || [];\n\nif (items.length === 0) {\n  throw new Error(`No accounts filings found for CRN: ${$('Normalise CRN').item.json.company_crn}`);\n}\n\n// Filter for valid account descriptions and document metadata links\nconst accountsFiling = items.find(item => \n  item.category === 'accounts' && \n  item.links && \n  item.links.document_metadata\n);\n\nif (!accountsFiling) {\n  throw new Error('No downloadable accounts metadata link found in filing history.');\n}\n\n// Extract the raw document metadata URL\n// e.g. \"https://document-api.company-information.service.gov.uk/document/{doc_id}\"\nconst docMetadataUrl = accountsFiling.links.document_metadata;\nconst filingDate = accountsFiling.date;\nconst description = accountsFiling.description || '';\n\n// Approximate financial year from action_date or filing date\nconst financialYear = accountsFiling.action_date \n  ? new Date(accountsFiling.action_date).getFullYear() \n  : new Date(filingDate).getFullYear();\n\nreturn {\n  ...$('Normalise CRN').item.json,\n  filing_date: filingDate,\n  financial_year: financialYear,\n  filing_description: description,\n  doc_metadata_url: docMetadataUrl\n};"
      },
