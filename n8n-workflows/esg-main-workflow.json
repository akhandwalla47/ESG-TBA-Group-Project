      "parameters": {
        "jsCode": "// Webhook calls nest fields under body; pinned/test data may be flat\nconst input = ($json.body && typeof $json.body === 'object') ? $json.body : $json;\nlet crn = String(input.company_crn || '').trim();\n\n// If numeric and less than 8 chars, pad with leading zeros\nif (/^\\d+$/.test(crn)) {\n  crn = crn.padStart(8, '0');\n}\n\nreturn {\n  ...input,\n  company_crn: crn\n};"
      },
