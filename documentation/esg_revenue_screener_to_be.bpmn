<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:bioc="http://bpmn.io/schema/bpmn/biocolor/1.0" xmlns:color="http://www.omg.org/spec/BPMN/non-normative/color/1.0" id="Definitions_ESGRevenueScreener" targetNamespace="http://example.com/esg-revenue-screener" exporter="Camunda Modeler" exporterVersion="5.51.0">
  <bpmn:collaboration id="Collaboration_ESG">
    <bpmn:participant id="Participant_ESG" name="ESG Revenue Screener — To-Be Process" processRef="Process_ESG" />
  </bpmn:collaboration>
  <bpmn:process id="Process_ESG" name="ESG Revenue Screening" isExecutable="false">
    <bpmn:laneSet id="LaneSet_ESG">
      <bpmn:lane id="Lane_Airtable" name="Streamlit Dashboard / User Interface">
        <bpmn:flowNodeRef>StartEvent_Request</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SelectCompany</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_08p3t36</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0agguhg</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DisplayResults</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Complete</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_0relolg</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_External" name="External Data">
        <bpmn:flowNodeRef>Task_CompaniesHouse</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_n8n" name="n8n — Workflow Orchestration">
        <bpmn:flowNodeRef>Task_ReceiveRequest</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_1vyqiip</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GetFilingHistory</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_AccountsFound</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FlagNoAccounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DownloadAccounts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DocumentProcessing</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_HandleFailure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Failure</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_0blj7hi</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Activity_12mi0zn</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LLMExtraction</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ExtractRevenue</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ClassifyStreams</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LLMClassification</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_WriteSheets</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateAirtable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Error</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:serviceTask id="Task_ReceiveRequest" name="Retrieve company identifier from DB">
      <bpmn:incoming>Flow_07m3zp4</bpmn:incoming>
      <bpmn:outgoing>Flow_1axwcr7</bpmn:outgoing>
      <bpmn:property id="Property_1wc6lew" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_07evsv3">
        <bpmn:sourceRef>DataStoreReference_153xxlw</bpmn:sourceRef>
        <bpmn:targetRef>Property_1wc6lew</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:task id="Activity_1vyqiip" name="Use company ID and CRN to search for existing company filing record">
      <bpmn:incoming>Flow_1axwcr7</bpmn:incoming>
      <bpmn:outgoing>Flow_1gpxxms</bpmn:outgoing>
      <bpmn:property id="Property_0ki5bwh" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1mikg9a">
        <bpmn:sourceRef>DataStoreReference_1gs8h37</bpmn:sourceRef>
        <bpmn:targetRef>Property_0ki5bwh</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_07m3zp4" sourceRef="Activity_08p3t36" targetRef="Task_ReceiveRequest" />
    <bpmn:sequenceFlow id="Flow_1axwcr7" sourceRef="Task_ReceiveRequest" targetRef="Activity_1vyqiip" />
    <bpmn:sequenceFlow id="Flow_10" sourceRef="Task_DocumentProcessing" targetRef="Task_LLMExtraction" />
    <bpmn:sequenceFlow id="Flow_16" sourceRef="Task_LLMClassification" targetRef="Task_WriteSheets" />
    <bpmn:startEvent id="StartEvent_Request" name="User wants to screen a company">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:task id="Task_SelectCompany" name="Select one or more from a list of positive or exclusionary ESG criteria to screen against">
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_1cr3mmn</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_08p3t36" name="Set a threshold value for each criterion which will be the max/min depending on the screening type (positive/exclusionary)">
      <bpmn:incoming>Flow_1cr3mmn</bpmn:incoming>
      <bpmn:outgoing>Flow_07m3zp4</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_10x3yzl">
        <bpmn:targetRef>DataStoreReference_1ibpp5r</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_1" sourceRef="StartEvent_Request" targetRef="Task_SelectCompany" />
    <bpmn:sequenceFlow id="Flow_1cr3mmn" sourceRef="Task_SelectCompany" targetRef="Activity_08p3t36" />
    <bpmn:dataStoreReference id="DataStoreReference_153xxlw" />
    <bpmn:dataStoreReference id="DataStoreReference_1ibpp5r" />
    <bpmn:sequenceFlow id="Flow_1gpxxms" sourceRef="Activity_1vyqiip" targetRef="Task_GetFilingHistory" />
    <bpmn:serviceTask id="Task_GetFilingHistory" name="Use company CRN to find latest filing in Companies House API">
      <bpmn:incoming>Flow_1gpxxms</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_1qhqdpp</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_CompaniesHouse" name="Companies House API returns filing history">
      <bpmn:incoming>Flow_7</bpmn:incoming>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_AccountsFound" name="Relevant accounts filing found?">
      <bpmn:incoming>Flow_1qhqdpp</bpmn:incoming>
      <bpmn:outgoing>Flow_YesAccounts</bpmn:outgoing>
      <bpmn:outgoing>Flow_NoAccounts</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Task_FlagNoAccounts" name="Flag unavailable accounts / no suitable filing">
      <bpmn:incoming>Flow_NoAccounts</bpmn:incoming>
      <bpmn:outgoing>Flow_0gc8prc</bpmn:outgoing>
    </bpmn:task>
    <bpmn:serviceTask id="Task_DownloadAccounts" name="Download latest relevant accounts document">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_DocumentProcessing" name="Extract PDF text / tables; apply OCR if required">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:incoming>Flow_0mo4h0x</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:task id="Task_HandleFailure" name="Record failure and update Airtable with error status">
      <bpmn:incoming>Flow_Error</bpmn:incoming>
      <bpmn:outgoing>Flow_FailureEnd</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Failure" name="User informed screening could not complete">
      <bpmn:incoming>Flow_FailureEnd</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:boundaryEvent id="Boundary_Error" name="Technical/API error" attachedToRef="Task_GetFilingHistory">
      <bpmn:outgoing>Flow_Error</bpmn:outgoing>
      <bpmn:errorEventDefinition />
    </bpmn:boundaryEvent>
    <bpmn:dataObjectReference id="DataObjectReference_0dq1b91" name="Stretch goal: at the moment companies are pre-selected that have relevant filings" dataObjectRef="DataObject_1np4vdr" />
    <bpmn:dataObject id="DataObject_1np4vdr" />
    <bpmn:exclusiveGateway id="Gateway_0blj7hi" name="Does the latest filing match one already in our database?">
      <bpmn:incoming>Flow_YesAccounts</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_1qzv97y</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:task id="Activity_12mi0zn" name="Fetch file from n8n cloud using file path">
      <bpmn:incoming>Flow_1qzv97y</bpmn:incoming>
      <bpmn:outgoing>Flow_0mo4h0x</bpmn:outgoing>
    </bpmn:task>
    <bpmn:task id="Activity_0agguhg" name="Return message to user stating that no relevant filing was found">
      <bpmn:incoming>Flow_0gc8prc</bpmn:incoming>
    </bpmn:task>
    <bpmn:sequenceFlow id="Flow_7" sourceRef="Task_GetFilingHistory" targetRef="Task_CompaniesHouse" />
    <bpmn:sequenceFlow id="Flow_1qhqdpp" sourceRef="Task_GetFilingHistory" targetRef="Gateway_AccountsFound" />
    <bpmn:sequenceFlow id="Flow_YesAccounts" name="Yes" sourceRef="Gateway_AccountsFound" targetRef="Gateway_0blj7hi" />
    <bpmn:sequenceFlow id="Flow_NoAccounts" name="No" sourceRef="Gateway_AccountsFound" targetRef="Task_FlagNoAccounts" />
    <bpmn:sequenceFlow id="Flow_0gc8prc" sourceRef="Task_FlagNoAccounts" targetRef="Activity_0agguhg" />
    <bpmn:sequenceFlow id="Flow_8" name="No" sourceRef="Gateway_0blj7hi" targetRef="Task_DownloadAccounts" />
    <bpmn:sequenceFlow id="Flow_9" sourceRef="Task_DownloadAccounts" targetRef="Task_DocumentProcessing" />
    <bpmn:sequenceFlow id="Flow_0mo4h0x" sourceRef="Activity_12mi0zn" targetRef="Task_DocumentProcessing" />
    <bpmn:sequenceFlow id="Flow_Error" sourceRef="Boundary_Error" targetRef="Task_HandleFailure" />
    <bpmn:sequenceFlow id="Flow_FailureEnd" sourceRef="Task_HandleFailure" targetRef="EndEvent_Failure" />
    <bpmn:sequenceFlow id="Flow_1qzv97y" name="Yes" sourceRef="Gateway_0blj7hi" targetRef="Activity_12mi0zn" />
    <bpmn:serviceTask id="Task_LLMExtraction" name="LLM extracts disclosed revenue streams and evidence">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_LLMExtraction" targetRef="Task_ExtractRevenue" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_ExtractRevenue" targetRef="Task_ClassifyStreams" />
    <bpmn:sequenceFlow id="Flow_15" sourceRef="Task_ClassifyStreams" targetRef="Task_LLMClassification" />
    <bpmn:task id="Task_DisplayResults" name="Display all companies with overall RAG category based on whether it meets all criteria (green) or not (red) or is missing information (amber)">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:task>
    <bpmn:endEvent id="EndEvent_Complete" name="Screening result available">
      <bpmn:incoming>Flow_004qcqh</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:task id="Activity_0relolg" name="User selects an individual company or companies for comparison">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_004qcqh</bpmn:outgoing>
    </bpmn:task>
    <bpmn:dataObjectReference id="DataObjectReference_1tvi7pc" name="A company will have an amber rating if for one or more criterion there isn&#39;t enough evidence to determine if it passes or fails AND the company has not failed any other criterion" dataObjectRef="DataObject_1y2xof6" />
    <bpmn:dataObject id="DataObject_1y2xof6" />
    <bpmn:sequenceFlow id="Flow_19" sourceRef="Task_WriteSheets" targetRef="Task_UpdateAirtable" />
    <bpmn:sequenceFlow id="Flow_21" sourceRef="Task_UpdateAirtable" targetRef="Task_DisplayResults" />
    <bpmn:sequenceFlow id="Flow_23" sourceRef="Task_DisplayResults" targetRef="Activity_0relolg" />
    <bpmn:sequenceFlow id="Flow_004qcqh" sourceRef="Activity_0relolg" targetRef="EndEvent_Complete" />
    <bpmn:dataStoreReference id="DataStoreReference_1gs8h37" />
    <bpmn:serviceTask id="Task_ExtractRevenue" name="Structure extracted revenue data">
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_ClassifyStreams" name="Classify each revenue stream against user-specified ESG criteria">
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LLMClassification" name="LLM proposes Green (pass) / Amber (insufficient info) / Red (fail) for each criteria  with rationale">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_WriteSheets" name="Store company, revenue streams, evidence, criteria and screening results in DB">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOutputAssociation_1arrj3t">
        <bpmn:targetRef>DataStoreReference_02xgj9p</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_UpdateAirtable" name="Fetch full company information and screening outcome from table">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
      <bpmn:property id="Property_02bkuyf" name="__targetRef_placeholder" />
      <bpmn:dataInputAssociation id="DataInputAssociation_1pow7fl">
        <bpmn:sourceRef>DataStoreReference_02xgj9p</bpmn:sourceRef>
        <bpmn:targetRef>Property_02bkuyf</bpmn:targetRef>
      </bpmn:dataInputAssociation>
    </bpmn:serviceTask>
    <bpmn:dataStoreReference id="DataStoreReference_02xgj9p" />
  </bpmn:process>
